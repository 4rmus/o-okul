# Staging production-evidence env contract.
# Fill a private copy with real staging values, validate it with:
# node scripts/check-staging-evidence-env.mjs --env-file /path/to/staging-evidence.env
#
# The staging deploy workflow appends SENTRY_RELEASE, ROLLBACK_IMAGE_TAG,
# GITHUB_CI_EVIDENCE_TARGET and PRODUCTION_EVIDENCE_SUMMARY_TARGET.
# Smoke evidence file paths are defaulted by --summary-file under artifacts/staging/smoke/.
# This includes report-generation.json.
# Required keys must be present with non-empty real values; placeholders are rejected for private env files.
# Netgsm and S3 credential placeholders must be replaced by real values before validation.
# Evidence targets must be file:// artifact paths or https:// URLs; http:// targets are rejected.
# SMS_SMOKE_CONFIRM and SENTRY_SMOKE_CONFIRM must stay send for real evidence runs.
# ALERT_WEBHOOK_TOKEN must be a real bearer secret with at least 32 characters.

NODE_ENV=production
APP_URL=https://__SET_STAGING_WEB_HOST__
API_URL=https://__SET_STAGING_API_HOST__
WEB_URL=https://__SET_STAGING_WEB_HOST__

DATABASE_URL=postgresql://app:__SET_APP_DB_PASSWORD__@__SET_STAGING_DB_HOST__:5432/o_okul
DIRECT_DATABASE_URL=postgresql://migration:__SET_MIGRATION_DB_PASSWORD__@__SET_STAGING_DB_HOST__:5432/o_okul
SECRET_DELIVERY_OUTBOX_DATABASE_URL=postgresql://secret_delivery_worker:__SET_SECRET_DELIVERY_WORKER_DB_PASSWORD__@__SET_STAGING_DB_HOST__:5432/o_okul
DOCKER_SECRET_DELIVERY_OUTBOX_DATABASE_URL=postgresql://secret_delivery_worker:__SET_SECRET_DELIVERY_WORKER_DB_PASSWORD__@postgres:5432/o_okul
SECRET_DELIVERY_WORKER_DB_PASSWORD=__SET_SECRET_DELIVERY_WORKER_DB_PASSWORD__
# Secret delivery outbox source ID bu env/secret dosyasına konmaz. Verify-only workflow, seçilen tag için
# host-side private sibling dizindeki 0600 source-id dosyasını kullanır; dosya artifact'a yazılmaz.
JWT_ACCESS_SECRET=__SET_REAL_ACCESS_SECRET__
STUDENT_PII_ENCRYPTION_KEY=__SET_REAL_STUDENT_PII_ENCRYPTION_KEY__
STUDENT_PII_HASH_KEY=__SET_REAL_STUDENT_PII_HASH_KEY__
ADMIN_MFA_MODE=required
ADMIN_MFA_SECRET_ENCRYPTION_KEY=__SET_REAL_ADMIN_MFA_SECRET_ENCRYPTION_KEY__
SECRET_DELIVERY_ENCRYPTION_KEY=__SET_REAL_SECRET_DELIVERY_ENCRYPTION_KEY__
ADMIN_MFA_RECOVERY_HASH_KEY=__SET_REAL_ADMIN_MFA_RECOVERY_HASH_KEY__
ADMIN_MFA_CHALLENGE_SECRET=__SET_REAL_ADMIN_MFA_CHALLENGE_SECRET__
ADMIN_MFA_ISSUER=o-okul
DOMAIN=__SET_STAGING_ROOT_DOMAIN__
CF_DNS_API_TOKEN_FILE=./secrets/cloudflare_dns_api_token
LEGACY_TENANT_LOGIN_CUTOFF_AT=__SET_LEGACY_TENANT_LOGIN_CUTOFF_AT__
COOKIE_SECURE=true

LOG_LEVEL=info
LOG_ENABLED=true
OPENAPI_UI_ENABLED=false
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_STORE=redis
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
DOCKER_PROXY_SUBNET=__SET_STAGING_PROXY_SUBNET__
DOCKER_PROXY_NETWORK=o-okul_proxy_net
TRAEFIK_PROXY_IP=__SET_STAGING_TRAEFIK_PROXY_IP__
API_PROXY_IP=__SET_STAGING_API_PROXY_IP__
RATE_LIMIT_SMOKE_EGRESS_IP=__SET_STAGING_RATE_LIMIT_SMOKE_EGRESS_IP__
TRUSTED_PROXY_CIDRS=__SET_STAGING_TRAEFIK_PROXY_IP__/32
# Üstte başka proxy yoksa boş kalır; varsa yalnız onun CIDR'larını girin.
TRAEFIK_TRUSTED_FORWARDER_CIDRS=
IDEMPOTENCY_STORE=postgres
REPORT_PDF_RENDERER=worker
REPORT_PDF_RENDER_TIMEOUT_MS=30000
PERSISTENCE_DRIVER=postgres
QUEUE_METRICS_ENABLED=true
QUEUE_BOARD_BASIC_AUTH_USER=__SET_QUEUE_BOARD_USER__
QUEUE_BOARD_BASIC_AUTH_PASSWORD=__SET_QUEUE_BOARD_PASSWORD__

SMS_ENABLED=false
NEXT_PUBLIC_SMS_ENABLED=false
SMS_PROVIDER=noop
SMS_ALLOW_NOOP_IN_PRODUCTION=false

NOTIFICATION_PROVIDER=http
NOTIFICATION_ALLOW_NOOP_IN_PRODUCTION=false
NOTIFICATION_HTTP_ENDPOINT=https://__SET_NOTIFICATION_ENDPOINT__
NOTIFICATION_HTTP_BEARER_TOKEN=__SET_NOTIFICATION_BEARER_TOKEN__
NOTIFICATION_SMOKE_EMAIL_TO=__SET_STAGING_EMAIL_TO__
NOTIFICATION_SMOKE_PUSH_TO=__SET_STAGING_PUSH_TO__
NOTIFICATION_SMOKE_SUBJECT=o-okul staging notification smoke
NOTIFICATION_SMOKE_BODY=o-okul staging notification smoke
NOTIFICATION_SMOKE_CONFIRM=send

S3_ENDPOINT=https://__SET_S3_ENDPOINT__
S3_REGION=tr
S3_BUCKET=__SET_STAGING_BUCKET__
S3_ACCESS_KEY_ID=__SET_S3_ACCESS_KEY_ID__
S3_SECRET_ACCESS_KEY=__SET_S3_SECRET_ACCESS_KEY__
S3_FORCE_PATH_STYLE=false
SUPPORT_ATTACHMENT_STORAGE=s3
HOMEWORK_MATERIAL_FILE_STORAGE=s3
UPLOAD_AV_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000

SENTRY_DSN=https://__SET_SENTRY_DSN__
NEXT_PUBLIC_SENTRY_DSN=https://__SET_SENTRY_DSN__
SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_SEND_DEFAULT_PII=false
SENTRY_SMOKE_CONFIRM=send
SENTRY_SMOKE_MESSAGE=o-okul staging Sentry smoke

TRAEFIK_HTTPS_SMOKE_URL=https://__SET_STAGING_WEB_HOST__/
BACKUP_PATH=/backups
BACKUP_RETENTION_DAYS=7
WAL_ARCHIVE_TARGET=s3://__SET_WAL_ARCHIVE_BUCKET__/staging

DEPLOYMENT_ROLLBACK_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/deployment-rollback.json
RESTORE_DRILL_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/restore-drill.json
KVKK_INVENTORY_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/kvkk-inventory.json
IDENTITY_MIGRATION_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/identity-migration.json
FINANCIAL_RETENTION_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/financial-retention.json
UPLOAD_AV_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/upload-av.json
OBSERVABILITY_UAT_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/observability-uat.json
EXTERNAL_MONITORING_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/external-monitoring.json
ADMIN_MFA_EVIDENCE_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/admin-mfa.json
SECURITY_AUDIT_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/security-audit.json
UAT_EVIDENCE_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/uat.json
ISEM_OPTICAL_PIPELINE_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/isem-optical-pipeline.json
LIVE_EXAM_CYCLE_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/live-exam-cycle.json
LIVE_UI_WORKER_RESULT_EVIDENCE_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/live-ui-worker-result.json
INLINE_UPLOAD_CONTENT_MIGRATION_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/inline-upload-content-migration.json
AUDIT_NULL_TENANT_EVIDENCE_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/audit-null-tenant.json
RATE_LIMIT_EVIDENCE_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/rate-limit.json
RLS_LIVE_EVIDENCE_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/rls-live.json
PILOT_EVIDENCE_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/pilot.json
GO_LIVE_EVIDENCE_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/go-live.json
LIVE_STATUS_EVIDENCE_TARGET=https://__SET_STAGING_WEB_HOST__/evidence/live-status.json

