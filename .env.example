NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3100
WEB_URL=http://localhost:3000
# Comma-separated additional browser origins accepted by the API CORS allow-list.
CORS_ORIGINS=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3100
WEB_HOST_PORT=3001
API_HOST_PORT=3100
PORT=3100

# Bu depo aynı sunucuda tek-node pilot çalışması için varsayılan kaynak tavanları verir.
# 4 vCPU / 8 GiB RAM sınıfı bir makinede önce bu değerlerle başla; ölçüm sonrası yükselt.
WEB_CPUS=0.75
WEB_MEM_LIMIT=768m
WEB_NODE_OPTIONS=--max-old-space-size=512
API_CPUS=1.00
API_MEM_LIMIT=1g
API_NODE_OPTIONS=--max-old-space-size=768
WORKER_CPUS=1.50
WORKER_MEM_LIMIT=2g
WORKER_NODE_OPTIONS=--max-old-space-size=1536
QUEUE_BOARD_CPUS=0.25
QUEUE_BOARD_MEM_LIMIT=256m
QUEUE_BOARD_NODE_OPTIONS=--max-old-space-size=256
POSTGRES_CPUS=1.00
POSTGRES_MEM_LIMIT=1536m
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=2GB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
POSTGRES_MAX_CONNECTIONS=80
REDIS_CPUS=0.50
REDIS_MEM_LIMIT=512m
REDIS_MAXMEMORY=384mb
MINIO_CPUS=0.50
MINIO_MEM_LIMIT=768m
CLAMAV_CPUS=0.75
CLAMAV_MEM_LIMIT=1536m
LOG_LEVEL=debug
LOG_ENABLED=true
OPENAPI_UI_ENABLED=false
API_RATE_LIMIT_ENABLED=
API_RATE_LIMIT_STORE=
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
IDEMPOTENCY_STORE=

DATABASE_URL=postgresql://app:app@localhost:5432/uzman_hocam
DIRECT_DATABASE_URL=postgresql://migration:migration@localhost:5432/uzman_hocam
# Docker Compose servisleri container ağı içinden service DNS kullanır; host scriptleri için
# yukarıdaki localhost URL'leri korunur.
DOCKER_DATABASE_URL=postgresql://app:app@postgres:5432/uzman_hocam
DOCKER_DIRECT_DATABASE_URL=postgresql://migration:migration@postgres:5432/uzman_hocam
# demo: system + demo kurum verisi; minimal: yalnız system tenant + SYSTEM_ADMIN
SEED_MODE=demo
# Tüm store'lar için tek kalıcılık sürücüsü. Yerel geliştirmede `memory` (Postgres gerektirmez).
# Production'da `postgres` ZORUNLUDUR; boot guard (assertPersistenceConfig) aksini reddeder.
PERSISTENCE_DRIVER=memory
STUDENT_QUOTA=200
POSTGRES_DB=uzman_hocam
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
APP_DB_USER=app
APP_DB_PASSWORD=app
MIGRATION_DB_USER=migration
MIGRATION_DB_PASSWORD=migration

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
STUDENT_PII_ENCRYPTION_KEY=change-me
STUDENT_PII_HASH_KEY=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

REDIS_URL=redis://localhost:6379
DOCKER_REDIS_URL=redis://redis:6379
QUEUE_PREFIX=uzman_hocam
QUEUE_METRICS_ENABLED=
QUEUE_BOARD_HOST_PORT=3200
QUEUE_BOARD_BASE_PATH=/admin/queues
QUEUE_BOARD_BASIC_AUTH_USER=admin
QUEUE_BOARD_BASIC_AUTH_PASSWORD=change-me-queue-board-password-min-32-chars
UPTIME_KUMA_HOST_PORT=3003
ADMIN_MFA_MODE=off
ADMIN_MFA_SECRET_ENCRYPTION_KEY=
ADMIN_MFA_RECOVERY_HASH_KEY=
ADMIN_MFA_CHALLENGE_SECRET=
ADMIN_MFA_ISSUER=Uzman Hocam
AI_REPORT_SUMMARY_PROVIDER=disabled
# memory|worker; boş bırakılırsa PERSISTENCE_DRIVER=postgres için worker kullanılır.
REPORT_PDF_RENDERER=memory
REPORT_GENERATION_SMOKE_EVIDENCE_FILE=
REPORT_PDF_RENDER_TIMEOUT_MS=30000
# memory|redis; boş bırakılırsa PERSISTENCE_DRIVER=postgres ve production Redis kullanır.
LOGIN_ATTEMPT_LIMITER_STORE=
SMS_PROVIDER=noop
SMS_ALLOW_NOOP_IN_PRODUCTION=false
SMS_SMOKE_TO=
SMS_SMOKE_BODY=
SMS_SMOKE_CONFIRM=
SMS_PROVIDER_SMOKE_EVIDENCE_FILE=
NETGSM_ENDPOINT=https://api.netgsm.com.tr/sms/rest/v2/send
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSG_HEADER=
NETGSM_IYS_FILTER=0
NETGSM_APP_NAME=
NOTIFICATION_PROVIDER=noop
NOTIFICATION_ALLOW_NOOP_IN_PRODUCTION=false
NOTIFICATION_HTTP_ENDPOINT=
NOTIFICATION_HTTP_BEARER_TOKEN=
NOTIFICATION_SMOKE_EMAIL_TO=
NOTIFICATION_SMOKE_PUSH_TO=
NOTIFICATION_SMOKE_SUBJECT=
NOTIFICATION_SMOKE_BODY=
NOTIFICATION_SMOKE_CONFIRM=
NOTIFICATION_PROVIDER_SMOKE_EVIDENCE_FILE=

S3_ENDPOINT=http://localhost:9000
# Container runtime icin internal object-storage endpoint'i. Ilk tek-sunucu fazinda MinIO
# backend network uzerinden kullanilir; production go-live env kapisi external HTTPS S3 ister.
DOCKER_S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=uzman-hocam-local
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
S3_FORCE_PATH_STYLE=true
SUPPORT_ATTACHMENT_STORAGE=inline
HOMEWORK_MATERIAL_FILE_STORAGE=inline
UPLOAD_AV_SCANNER=
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000
CLAMD_STARTUP_TIMEOUT=1800
# ClamAV varsayılan docker compose açılışında çalışmaz. Upload AV kanıtı veya fail-closed
# tarama gerektiğinde `docker compose --profile av up -d` ile ayrıca başlat.

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=false
SENTRY_SMOKE_CONFIRM=
SENTRY_SMOKE_MESSAGE=
SENTRY_SMOKE_EVIDENCE_FILE=

DOMAIN=localhost
SERVER_DOMAIN=localhost
ACME_EMAIL=admin@example.com
TRAEFIK_HTTPS_SMOKE_URL=
TRAEFIK_HTTPS_SMOKE_EVIDENCE_FILE=
TRAEFIK_HTTPS_SMOKE_ALLOW_INSECURE_TLS=false

BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_OFFSITE_TARGET=
BACKUP_OFFSITE_SMOKE_EVIDENCE_FILE=
WAL_ARCHIVE_TARGET=
WAL_ARCHIVE_SMOKE_EVIDENCE_FILE=
DEPLOYMENT_REGION_TARGET=
DEPLOYMENT_ROLLBACK_TARGET=
GITHUB_CI_EVIDENCE_TARGET=
RESTORE_DRILL_TARGET=
KVKK_INVENTORY_TARGET=
IDENTITY_MIGRATION_TARGET=
FINANCIAL_RETENTION_TARGET=
UPLOAD_AV_TARGET=
OBSERVABILITY_UAT_TARGET=
EXTERNAL_MONITORING_TARGET=
ADMIN_MFA_EVIDENCE_TARGET=
AI_REPORT_SUMMARY_EVIDENCE_TARGET=
SECURITY_AUDIT_TARGET=
UAT_EVIDENCE_TARGET=
LIVE_EXAM_CYCLE_TARGET=
ISEM_OPTICAL_PIPELINE_TARGET=
LIVE_UI_WORKER_RESULT_EVIDENCE_TARGET=
INLINE_UPLOAD_CONTENT_MIGRATION_TARGET=
AUDIT_NULL_TENANT_EVIDENCE_TARGET=
RATE_LIMIT_EVIDENCE_TARGET=
RLS_LIVE_EVIDENCE_TARGET=
RLS_LOAD_SMOKE_EVIDENCE_FILE=
PRODUCTION_EVIDENCE_SUMMARY_TARGET=
PILOT_EVIDENCE_TARGET=
GO_LIVE_EVIDENCE_TARGET=
LIVE_STATUS_EVIDENCE_TARGET=
NEXT_E2E_LIVE_ONBOARDING=
LIVE_ONBOARDING_EVIDENCE_PATH=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ALERT_WEBHOOK_SMOKE_EVIDENCE_FILE=
ROLLBACK_IMAGE_TAG=

CI_DATABASE_URL=postgresql://app:app@localhost:5432/uzman_hocam_ci
CI_REDIS_URL=redis://localhost:6379
SENTRY_AUTH_TOKEN=
SSH_HOST=
SSH_USER=
SSH_PRIVATE_KEY=
