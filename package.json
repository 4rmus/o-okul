{
  "name": "uzman-hocam",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "backup:offsite:smoke": "node scripts/smoke-backup-offsite.mjs",
    "backup:restore:smoke": "node scripts/smoke-backup-restore-live.mjs",
    "audit-log-partition:check": "node packages/db/scripts/check-audit-log-partition.mjs && node packages/db/scripts/check-audit-log-partition-maintenance-contract.mjs",
    "audit-log-partition:maintain": "node packages/db/scripts/maintain-audit-log-partitions.mjs",
    "ci": "pnpm docker:check && pnpm ops:check && pnpm prod:evidence:templates:check && pnpm karne:visual-contract:check && pnpm pii:contact-policy:check && pnpm web:token-storage:check && pnpm db:rls:check && pnpm audit-log-partition:check && pnpm live:onboarding:evidence-contract && pnpm live:ui-worker:evidence-contract && pnpm report-listing:k6:check && pnpm web:performance:check && pnpm web:a11y:check && pnpm web:backup-restore-panel:check && pnpm web:ux-baseline:check && pnpm web:ux-contract:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm openapi:generate",
    "compose:health:smoke": "node scripts/smoke-compose-health.mjs",
    "db:migrate": "pnpm --filter @uzman-hocam/db db:migrate",
    "db:rls:check": "pnpm --filter @uzman-hocam/db db:rls:check",
    "db:rls:check:live": "pnpm --filter @uzman-hocam/db db:rls:check:live",
    "db:seed": "pnpm --filter @uzman-hocam/db db:seed",
    "deployment:region:check": "node scripts/check-deployment-region-evidence.mjs",
    "deployment:rollback:check": "node scripts/check-deployment-rollback-evidence.mjs",
    "dev": "turbo run dev --parallel",
    "docker:check": "node scripts/check-docker-config.mjs",
    "external-monitoring:check": "node scripts/check-external-monitoring-evidence.mjs",
    "financial-retention:check": "node scripts/check-financial-retention-evidence.mjs",
    "go-live:check": "node scripts/check-go-live-evidence.mjs",
    "github-ci:generate": "node scripts/generate-github-ci-evidence.mjs",
    "github-ci:check": "node scripts/check-github-ci-evidence.mjs",
    "identity-link:audit": "node scripts/audit-identity-links-live.mjs",
    "identity-link:migrate": "node scripts/migrate-identity-links-live.mjs",
    "identity-migration:check": "node scripts/check-identity-migration-evidence.mjs",
    "inline-upload-content:audit": "node scripts/migrate-inline-upload-content-to-s3-live.mjs",
    "inline-upload-content:check": "node scripts/check-inline-upload-content-migration-evidence.mjs",
    "inline-upload-content:migrate": "node scripts/migrate-inline-upload-content-to-s3-live.mjs",
    "isem-answer-key:smoke": "pnpm --filter @uzman-hocam/api build && node scripts/smoke-isem-answer-key-live.mjs",
    "isem-optical-pipeline:smoke": "pnpm --filter @uzman-hocam/api build && pnpm --filter @uzman-hocam/worker build && node scripts/smoke-isem-optical-pipeline-live.mjs",
    "isem-student-import:smoke": "pnpm --filter @uzman-hocam/api build && node scripts/smoke-isem-student-import-live.mjs",
    "karne:visual-contract:check": "node scripts/check-karne-visual-contract.mjs",
    "karne:visual-diff": "node scripts/compare-karne-visual-evidence.mjs",
    "karne:visual-targets": "node scripts/check-adiguzel-pdf-visual-targets.mjs",
    "lint": "turbo run lint",
    "live:smoke": "pnpm compose:health:smoke && pnpm db:migrate && pnpm db:rls:check:live && pnpm postgres-stores:smoke && pnpm queue:smoke && pnpm raw-import:smoke && pnpm report-generation:smoke && pnpm backup:restore:smoke",
    "live:onboarding:evidence-check": "node scripts/check-live-onboarding-evidence-env.mjs",
    "live:onboarding:evidence-contract": "node scripts/check-live-onboarding-evidence-contract.mjs",
    "live:onboarding:smoke": "pnpm live:onboarding:evidence-check && pnpm --filter @uzman-hocam/web exec playwright test -c playwright.next.config.ts e2e-next/live-onboarding-next.spec.ts",
    "live:exam-cycle:check": "node scripts/check-live-exam-cycle-evidence.mjs",
    "live:status:generate": "node scripts/generate-live-status-evidence.mjs",
    "live:status:check": "node scripts/check-live-status-evidence.mjs",
    "live:ui-worker:evidence-check": "node scripts/check-live-ui-worker-evidence-env.mjs",
    "live:ui-worker:evidence-contract": "node scripts/check-live-ui-worker-evidence-contract.mjs",
    "live:ui-worker:smoke": "pnpm live:ui-worker:evidence-check && pnpm --filter @uzman-hocam/web exec playwright test -c playwright.next.config.ts e2e-next/live-ui-worker-report-next.spec.ts",
    "ops:check": "pnpm prod:plan:check && pnpm live:status:check && pnpm pii:contact-policy:check && pnpm audit-log-partition:check && pnpm live:onboarding:evidence-contract && pnpm live:ui-worker:evidence-contract && node scripts/check-ops-config.mjs && node scripts/check-tenant-db-access.mjs && node scripts/check-prod-readiness.mjs && node scripts/check-product-journeys.mjs",
    "openapi:generate": "node scripts/generate-openapi.mjs && node scripts/check-openapi-output-contract.mjs",
    "openapi:output-contract": "node scripts/check-openapi-output-contract.mjs",
    "pilot:check": "node scripts/check-pilot-evidence.mjs",
    "observability:uat:check": "node scripts/check-observability-uat-evidence.mjs",
    "privacy:inventory:check": "node scripts/check-kvkk-inventory-evidence.mjs",
    "pii:contact-policy:check": "node scripts/check-pii-contact-policy.mjs",
    "prod:env:check": "node scripts/check-prod-env.mjs",
    "prod:evidence:check": "pnpm --filter @uzman-hocam/sms-adapter build && pnpm --filter @uzman-hocam/notification-adapter build && node scripts/check-prod-evidence.mjs",
    "prod:evidence:summary:check": "node scripts/check-production-evidence-summary.mjs",
    "prod:evidence:templates:check": "node scripts/check-prod-evidence-templates.mjs",
    "prod:plan:check": "node scripts/check-prod-plan-status.mjs",
    "prod:readiness:check": "node scripts/check-prod-readiness.mjs",
    "postgres-stores:smoke": "pnpm --filter @uzman-hocam/api build && node scripts/smoke-postgres-stores-live.mjs",
    "product-journeys:check": "node scripts/check-product-journeys.mjs",
    "queue:smoke": "pnpm --filter @uzman-hocam/api build && pnpm --filter @uzman-hocam/worker build && node scripts/smoke-bullmq-live.mjs",
    "alert:webhook:smoke": "node scripts/smoke-alert-webhook.mjs",
    "admin-mfa:check": "node scripts/check-admin-mfa-evidence.mjs",
    "ai-report-summary:check": "node scripts/check-ai-report-summary-evidence.mjs",
    "raw-import:smoke": "pnpm --filter @uzman-hocam/api build && pnpm --filter @uzman-hocam/worker build && node scripts/smoke-raw-import-upload-live.mjs",
    "rate-limit:check": "node scripts/check-rate-limit-evidence.mjs",
    "rate-limit:smoke": "node scripts/smoke-rate-limit-live.mjs",
    "report-generation:smoke": "pnpm --filter @uzman-hocam/api build && pnpm --filter @uzman-hocam/worker build && node scripts/smoke-report-generation-live.mjs",
    "report-generation:perf": "pnpm --filter @uzman-hocam/api build && pnpm --filter @uzman-hocam/worker build && REPORT_GENERATION_SMOKE_RESULT_COUNT=10000 node scripts/smoke-report-generation-live.mjs",
    "report-listing:k6": "k6 run scripts/k6-report-listing.js",
    "report-listing:k6:check": "node scripts/check-k6-report-listing.mjs",
    "rls:live:check": "node scripts/check-rls-live-evidence.mjs",
    "rls:load:smoke": "node scripts/smoke-rls-load-live.mjs",
    "restore:drill:check": "node scripts/check-restore-drill-evidence.mjs",
    "notification:smoke": "pnpm --filter @uzman-hocam/notification-adapter build && node scripts/smoke-notification-provider.mjs",
    "security:audit:check": "node scripts/check-security-audit-evidence.mjs",
    "sms:smoke": "pnpm --filter @uzman-hocam/sms-adapter build && node scripts/smoke-sms-provider.mjs",
    "smoke:evidence:check": "node scripts/check-smoke-evidence-contract.mjs",
    "sentry:smoke": "node scripts/smoke-sentry-event.mjs",
    "staging:evidence-env:check": "node scripts/check-staging-evidence-env.mjs",
    "staging:first-gates:check": "node scripts/check-staging-first-gates-evidence.mjs",
    "staging:first-gates:smoke": "node scripts/run-staging-first-gate-smokes.mjs",
    "staging:release-artifacts:check": "node scripts/check-staging-release-artifacts.mjs",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "pnpm --filter @uzman-hocam/web test:e2e",
    "test:e2e:next": "pnpm --filter @uzman-hocam/web next:e2e",
    "tenant-db:check": "node scripts/check-tenant-db-access.mjs",
    "traefik:https:smoke": "node scripts/smoke-traefik-https.mjs",
    "upload-av:check": "node scripts/check-upload-av-evidence.mjs",
    "typecheck": "turbo run typecheck",
    "uat:check": "node scripts/check-uat-evidence.mjs",
    "web:a11y:check": "pnpm --filter @uzman-hocam/web a11y",
    "web:backup-restore-panel:check": "pnpm --filter @uzman-hocam/web backup-restore-panel",
    "web:performance:check": "WEB_PERFORMANCE_BUDGET=1 node scripts/profile-web-performance.mjs && node scripts/check-web-performance-profile-contract.mjs",
    "web:token-storage:check": "node scripts/check-web-token-storage.mjs",
    "web:ux-baseline:check": "node scripts/check-web-ux-baseline.mjs",
    "web:ux-contract:check": "pnpm --filter @uzman-hocam/web ux-contract",
    "web:performance:profile": "node scripts/profile-web-performance.mjs",
    "web:performance:profile-contract": "node scripts/check-web-performance-profile-contract.mjs",
    "wal:archive:smoke": "node scripts/smoke-wal-archive-target.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1056.0",
    "@nestjs/core": "^11.1.24",
    "@sentry/node": "10.57.0",
    "pg": "^8.21.0",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3"
  }
}
