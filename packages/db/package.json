{
  "name": "@o-okul/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:audit-log-partition:check": "node scripts/check-audit-log-partition.mjs",
    "db:audit-log-partition:maintain": "node scripts/maintain-audit-log-partitions.mjs",
    "db:audit-log-partition:maintain-contract": "node scripts/check-audit-log-partition-maintenance-contract.mjs",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:rls:check": "tsx scripts/check-tenant-models-parity.ts && node scripts/check-rls.mjs && node scripts/check-tenant-relation-fks.mjs",
    "db:rls:check:live": "node scripts/check-rls-live.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "prisma validate --config prisma.config.ts && tsc -p tsconfig.json --noEmit",
    "test": "prisma validate --config prisma.config.ts && pnpm db:rls:check && pnpm db:audit-log-partition:check && pnpm db:audit-log-partition:maintain-contract && tsc -p tsconfig.json --noEmit && vitest run prisma/seed-exams.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:seed-exams": "tsx prisma/seed-exams.ts"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "pg": "^8.21.0"
  }
}
