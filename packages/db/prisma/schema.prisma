generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantRole {
  SYSTEM_ADMIN
  TENANT_OWNER
  TENANT_ADMIN
  ASSISTANT_ADMIN
  OPERATIONS_STAFF
  FINANCE_STAFF
  TEACHER
  STUDENT
  GUARDIAN
}

enum StaffRole {
  TENANT_OWNER
  TENANT_ADMIN
  OPERATIONS_STAFF
  FINANCE_STAFF
}

model Tenant {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  plan        String             @default("TRIAL")
  licenseStartsAt DateTime?          @db.Timestamptz(6)
  licenseEndsAt   DateTime?          @db.Timestamptz(6)
  institutionType String?
  contactEmail String?
  logoUrl     String?
  seatLimit   Int?
  status      String             @default("ACTIVE")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  users       User[]
  memberships TenantMembership[]
  authSessions AuthSession[]
  idempotencyKeys IdempotencyKey[]
  identityInvitations IdentityInvitation[]
  campuses    Campus[]
  gradeLevels GradeLevel[]
  alanlar     Alan[]
  gradeLevelCourses GradeLevelCourse[]
  classes     Class[]
  courses     Course[]
  academicYears AcademicYear[]
  academicTerms AcademicTerm[]
  students    Student[]
  studentEnrollments StudentEnrollment[]
  teacherAssignments TeacherAssignment[]
  attendance  Attendance[]
  teacherNotes TeacherNote[]
  developmentCriteria DevelopmentCriterion[]
  developmentAssessments DevelopmentAssessment[]
  developmentScores DevelopmentScore[]
  paymentPlans PaymentPlan[]
  paymentInstallments PaymentInstallment[]
  paymentTransactions PaymentTransaction[]
  teachers    Teacher[]
  guardians   Guardian[]
  guardianStudents GuardianStudent[]
  scheduleLessons ScheduleLesson[]
  studySessions StudySession[]
  studySessionStudents StudySessionStudent[]
  homeworkMaterials HomeworkMaterial[]
  homeworkMaterialFiles HomeworkMaterialFile[]
  homeworkMaterialAssignments HomeworkMaterialAssignment[]
  homework    Homework[]
  exams       Exam[]
  parserConfigs ParserConfig[]
  opticalFormTemplates OpticalFormTemplate[]
  learningOutcomes LearningOutcome[]
  examParticipants ExamParticipant[]
  rawImports  RawImport[]
  answerKeys  AnswerKey[]
  examBookletVariants ExamBookletVariant[]
  parsedAnswers ParsedAnswer[]
  examResults ExamResult[]
  importQuarantines ImportQuarantine[]
  reportSnapshots ReportSnapshot[]
  backupRestoreJobs BackupRestoreJob[]
  announcements Announcement[]
  announcementReceipts AnnouncementReceipt[]
  announcementDeliveryReports AnnouncementDeliveryReport[]
  messageTemplates MessageTemplate[]
  smsBatchDeliveryReports SmsBatchDeliveryReport[]
  supportTickets SupportTicket[]
  supportTicketAttachments SupportTicketAttachment[]
  supportTicketComments SupportTicketComment[]
  notificationDeviceTokens NotificationDeviceToken[]
  auditLogs   AuditLog[]
  licenseTerms LicenseTerm[]
  licenseUsages LicenseUsage[]
  employees Employee[]
  studentContacts StudentContact[]
  membershipCampusScopes MembershipCampusScope[]
}

model PlatformAccount {
  id                    String   @id @default(uuid())
  loginName             String
  loginNameNormalized   String   @unique
  email                 String?
  emailNormalized       String?  @unique
  name                  String
  passwordHash          String
  passwordHashVersion   Int      @default(2)
  status                String   @default("PENDING_ACTIVATION")
  totpSecretEncrypted   String?
  totpEnabledAt         DateTime? @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  sessions              PlatformSession[]
  createdLicenseTerms   LicenseTerm[]
  idempotencyKeys       PlatformIdempotencyKey[]

  @@index([status])
}

model PlatformIdempotencyKey {
  id                String   @id @default(uuid())
  platformAccountId String
  key               String
  operation         String
  requestHash       String
  status            String   @default("IN_PROGRESS")
  responseBody      Json?
  completedAt       DateTime? @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  platformAccount   PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@unique([platformAccountId, key, operation])
  @@index([status, createdAt])
}

model PlatformSession {
  id                 String   @id @default(uuid())
  platformAccountId  String
  tokenFamilyId      String
  refreshTokenHash   String   @unique
  status             String   @default("ACTIVE")
  expiresAt          DateTime @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  platformAccount    PlatformAccount @relation(fields: [platformAccountId], references: [id], onDelete: Cascade)

  @@index([platformAccountId, status])
  @@index([tokenFamilyId])
  @@index([expiresAt])
}

model DevelopmentCriterion {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  scaleMin  Int      @default(1)
  scaleMax  Int      @default(5)
  sortOrder Int      @default(0)
  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "DevelopmentCriterion_tenantId_fkey")
  scores DevelopmentScore[]

  @@unique([tenantId, id])
  @@index([tenantId, deletedAt])
}

model DevelopmentAssessment {
  id          String   @id @default(uuid())
  tenantId    String
  studentId   String
  teacherId   String
  termId      String?
  periodLabel String
  mentorNote  String?
  visibility  String   @default("GUARDIAN")
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "DevelopmentAssessment_tenantId_fkey")
  student Student @relation(fields: [tenantId, studentId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "DevelopmentAssessment_student_fkey")
  teacher Teacher @relation(fields: [tenantId, teacherId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "DevelopmentAssessment_teacher_fkey")
  scores DevelopmentScore[]

  @@unique([tenantId, id])
  @@index([tenantId, studentId, createdAt])
}

model DevelopmentScore {
  id           String   @id @default(uuid())
  tenantId     String
  assessmentId String
  criterionId  String
  score        Int
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "DevelopmentScore_tenantId_fkey")
  assessment DevelopmentAssessment @relation(fields: [tenantId, assessmentId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "DevelopmentScore_assessment_fkey")
  criterion DevelopmentCriterion @relation(fields: [tenantId, criterionId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "DevelopmentScore_criterion_fkey")

  @@unique([tenantId, id])
  @@unique([tenantId, assessmentId, criterionId])
}

model User {
  id          String             @id @default(uuid())
  tenantId    String?
  email       String?
  emailNormalized String?
  loginName String?
  loginNameNormalized String?
  nationalIdEncrypted String?
  nationalIdHash String?
  name        String
  passwordHash String
  passwordHashVersion Int        @default(1)
  accountStatus String            @default("ACTIVE")
  membershipVersion Int       @default(1)
  mustChangePassword Boolean     @default(false)
  passwordChangedAt DateTime?    @db.Timestamptz(6)
  totpSecretEncrypted String?
  totpEnabledAt DateTime? @db.Timestamptz(6)
  totpRecoveryCodeHashes String[] @default([])
  totpLastUsedCounter String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tenant      Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships TenantMembership[]
  authSessions AuthSession[]
  passwordResetTokens PasswordResetToken[]
  notificationDeviceTokens NotificationDeviceToken[]
  studentProfile Student?       @relation("StudentAccountUser")
  teacherProfile Teacher?       @relation("TeacherAccountUser")
  guardianProfile Guardian?     @relation("GuardianAccountUser")
  employeeProfile Employee?     @relation("EmployeeAccountUser")
  createdStudents Student[]      @relation("StudentCreatedBy")
  updatedStudents Student[]      @relation("StudentUpdatedBy")
  checkedHomework Homework[]      @relation("HomeworkCheckedBy")

  @@unique([tenantId, id])
  @@unique([tenantId, nationalIdHash])
  @@unique([tenantId, loginNameNormalized])
  @@unique([tenantId, emailNormalized])
  @@index([tenantId])
}

model NotificationDeviceToken {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  subjectType String?
  subjectId   String?
  provider    String
  token       String
  platform    String?
  lastSeenAt  DateTime
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, userId, token])
  @@index([tenantId, userId, disabledAt])
  @@index([tenantId, subjectType, subjectId, disabledAt], map: "NotificationDeviceToken_tenantId_subjectType_subjectId_disabled")
}

model TenantMembership {
  id        String     @id @default(uuid())
  tenantId  String
  userId    String
  role      TenantRole
  staffRole StaffRole?
  hasTeacherPersona Boolean @default(false)
  hasStudentPersona Boolean @default(false)
  status    String     @default("ACTIVE")
  version   Int        @default(1)
  startsAt  DateTime   @default(now()) @db.Timestamptz(6)
  endsAt    DateTime?  @db.Timestamptz(6)
  endedReason String?
  scopeMode String      @default("TENANT")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  campusScopes MembershipCampusScope[]
  authSessions AuthSession[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId, role])
  @@index([tenantId, userId, status])
  @@index([tenantId, role])
}

model MembershipCampusScope {
  id            String   @id @default(uuid())
  tenantId      String
  membershipId  String
  campusId      String
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership    TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  campus        Campus   @relation(fields: [tenantId, campusId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, membershipId, campusId])
  @@index([tenantId, campusId])
}

model LicenseTerm {
  id                         String   @id @default(uuid())
  tenantId                   String
  planCode                   String
  startsAt                   DateTime @db.Timestamptz(6)
  endsAt                     DateTime @db.Timestamptz(6)
  activeStudentLimit         Int
  cancelledAt                DateTime? @db.Timestamptz(6)
  createdByPlatformAccountId String?
  auditReference             String?
  createdAt                  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tenant                     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByPlatformAccount   PlatformAccount? @relation(fields: [createdByPlatformAccountId], references: [id], onDelete: Restrict)
  usages                     LicenseUsage[]

  @@unique([tenantId, id])
  @@index([tenantId, startsAt, endsAt])
  @@index([createdByPlatformAccountId])
}

model LicenseUsage {
  id                      String   @id @default(uuid())
  tenantId                String
  licenseTermId           String?
  usageDate               DateTime @db.Date
  activeStudentCount      Int      @default(0)
  peakActiveStudentCount  Int      @default(0)
  reconciledAt            DateTime? @db.Timestamptz(6)
  createdAt               DateTime @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  licenseTerm             LicenseTerm? @relation(fields: [tenantId, licenseTermId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, usageDate])
  @@index([tenantId, licenseTermId, usageDate])
}

model Employee {
  id                    String   @id @default(uuid())
  tenantId              String
  employeeNo            String?
  firstName             String
  lastName              String
  nationalIdEncrypted   String?
  nationalIdHash        String?
  workEmail             String?
  phone                 String?
  userId                String?
  status                String   @default("PLANNED")
  employmentStartsAt    DateTime? @db.Date
  employmentEndsAt      DateTime? @db.Date
  endedReason           String?
  deletedAt             DateTime? @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountUser           User?    @relation("EmployeeAccountUser", fields: [tenantId, userId], references: [tenantId, id], onDelete: NoAction)
  teacherProfile        Teacher?

  @@unique([tenantId, id])
  @@unique([tenantId, employeeNo])
  @@unique([tenantId, userId])
  @@unique([tenantId, nationalIdHash])
  @@index([tenantId, status, deletedAt])
  @@index([tenantId, workEmail])
}

model AuthSession {
  id                String   @id @default(uuid())
  userId            String
  tenantId          String
  membershipId      String?
  activePersona     String?
  roles             String[]
  subjectType       String?
  subjectId         String?
  deviceLabel       String?
  clientIpPrefix    String?
  lastSeenAt        DateTime @default(now()) @db.Timestamptz(6)
  tokenFamilyId     String
  refreshTokenHash  String   @unique
  status            String   @default("ACTIVE")
  membershipVersion Int      @default(1)
  expiresAt         DateTime @db.Timestamptz(6)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  membership        TenantMembership? @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, userId, status])
  @@index([tenantId, membershipId, status])
  @@index([tokenFamilyId])
  @@index([expiresAt])
}

model IdempotencyKey {
  id           String    @id @default(uuid())
  tenantId     String
  key          String
  operation    String
  requestHash  String
  status       String    @default("IN_PROGRESS")
  responseBody Json?
  completedAt  DateTime? @db.Timestamptz(6)
  expiresAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, operation])
  @@index([tenantId, status, createdAt])
}

model IdentityInvitation {
  id           String   @id @default(uuid())
  tenantId     String
  subjectType  String
  subjectId    String
  email        String?
  name         String
  role         TenantRole
  kind         String   @default("EMAIL_LINK")
  tokenHash    String   @unique
  status       String   @default("PENDING")
  failedAttempts Int    @default(0)
  maxAttempts  Int      @default(5)
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedUserId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, subjectType, subjectId, status])
  @@index([tenantId, email])
  @@index([tenantId, subjectId, kind, status, expiresAt], map: "IdentityInvitation_student_code_lookup_idx")
}

/// Global auth altyapı tablosu: token aile takibi User üzerinden yapılır ve
/// sistem kullanıcıları (User.tenantId NULL) da kapsandığı için tenant RLS uygulanamaz.
model ConsumedRefreshToken {
  refreshTokenHash String   @id
  tokenFamilyId    String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tokenFamilyId])
}

/// Global auth altyapı tablosu: global User kimliğine bağlıdır ve sistem
/// kullanıcıları (User.tenantId NULL) da şifre sıfırlayabildiği için tenant RLS uygulanamaz.
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  status    String   @default("PENDING")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// Global auth delivery infrastructure. The recipient, link, and token-bearing
/// message exist only inside payloadEncrypted and are erased after terminal delivery.
model SecretDeliveryOutbox {
  id               String   @id @default(uuid())
  tenantId         String?
  purpose          String
  sourceId         String
  payloadEncrypted String?
  status           String   @default("PENDING")
  attempts         Int      @default(0)
  availableAt      DateTime @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime @db.Timestamptz(6)
  claimedAt        DateTime? @db.Timestamptz(6)
  deliveredAt      DateTime? @db.Timestamptz(6)
  lastErrorCode    String?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status, availableAt])
  @@index([tenantId, purpose, createdAt])
  @@index([purpose, sourceId, status])
}

model Class {
  id        String    @id @default(uuid())
  tenantId  String
  campusId  String?
  gradeLevelId String?
  alanId    String?
  name      String
  section   String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campus    Campus?   @relation(fields: [tenantId, campusId], references: [tenantId, id], onDelete: Restrict)
  gradeLevel GradeLevel? @relation(fields: [tenantId, gradeLevelId], references: [tenantId, id], onDelete: Restrict)
  alan      Alan?     @relation(fields: [tenantId, alanId], references: [tenantId, id], onDelete: Restrict)
  students  Student[]
  studentEnrollments StudentEnrollment[]
  teacherAssignments TeacherAssignment[]
  scheduleLessons ScheduleLesson[]
  studySessions StudySession[]
  homework  Homework[]
  supportTickets SupportTicket[]
  reportSnapshots ReportSnapshot[]
  paymentPlans PaymentPlan[]

  @@unique([tenantId, id])
  @@index([tenantId, campusId])
  @@index([tenantId, gradeLevelId])
  @@index([tenantId, alanId])
  @@index([tenantId, deletedAt])
}

model GradeLevel {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  code      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alanlar   Alan[]
  gradeLevelCourses GradeLevelCourse[]
  classes   Class[]
  exams     Exam[]
  supportTickets SupportTicket[]
  reportSnapshots ReportSnapshot[]
  paymentPlans PaymentPlan[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
}

model Alan {
  id        String    @id @default(uuid())
  tenantId  String
  gradeLevelId String?
  name      String
  code      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gradeLevel GradeLevel? @relation(fields: [tenantId, gradeLevelId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  classes   Class[]
  exams     Exam[]
  gradeLevelCourses GradeLevelCourse[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, gradeLevelId])
  @@index([tenantId, deletedAt])
}

model Campus {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  code      String?
  unitType  String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classes   Class[]
  supportTickets SupportTicket[]
  reportSnapshots ReportSnapshot[]
  paymentPlans PaymentPlan[]
  membershipScopes MembershipCampusScope[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
}

model Course {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  code      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gradeLevelCourses GradeLevelCourse[]
  teacherAssignments TeacherAssignment[]
  scheduleLessons ScheduleLesson[]
  studySessions StudySession[]
  attendance Attendance[]
  teacherNotes TeacherNote[]
  homeworkMaterialAssignments HomeworkMaterialAssignment[]
  supportTickets SupportTicket[]
  reportSnapshots ReportSnapshot[]
  paymentPlans PaymentPlan[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
}

model GradeLevelCourse {
  id           String   @id @default(uuid())
  tenantId     String
  gradeLevelId String
  courseId     String
  alanId       String?
  isDefault    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gradeLevel   GradeLevel @relation(fields: [tenantId, gradeLevelId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  course       Course   @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)
  alan         Alan?    @relation(fields: [tenantId, alanId], references: [tenantId, id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, gradeLevelId])
  @@index([tenantId, courseId])
  @@index([tenantId, alanId])
}

model AcademicYear {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  startsAt  DateTime  @db.Date
  endsAt    DateTime  @db.Date
  isActive  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terms     AcademicTerm[]
  studentEnrollments StudentEnrollment[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, isActive, deletedAt])
}

model AcademicTerm {
  id             String    @id @default(uuid())
  tenantId       String
  academicYearId String
  name           String
  startsAt       DateTime  @db.Date
  endsAt         DateTime  @db.Date
  isActive       Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear @relation(fields: [tenantId, academicYearId], references: [tenantId, id], onDelete: Cascade)
  teacherAssignments TeacherAssignment[]
  scheduleLessons ScheduleLesson[]
  studySessions StudySession[]
  attendance Attendance[]
  teacherNotes TeacherNote[]
  homeworkMaterialAssignments HomeworkMaterialAssignment[]
  supportTickets SupportTicket[]
  reportSnapshots ReportSnapshot[]
  paymentPlans PaymentPlan[]
