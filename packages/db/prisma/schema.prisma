  gradeLevelId String?
  classId      String?
  courseId     String?
  termId       String?
  reportType   String
  contentHash  String
  status       String    @default("PENDING")
  inputRefs    Json
  snapshotData Json?
  generatedAt  DateTime?
  staleAt      DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exam         Exam      @relation(fields: [tenantId, examId], references: [tenantId, id], onDelete: Cascade)
  campus       Campus?   @relation(fields: [tenantId, campusId], references: [tenantId, id], onDelete: Restrict)
  gradeLevel   GradeLevel? @relation(fields: [tenantId, gradeLevelId], references: [tenantId, id], onDelete: Restrict)
  class        Class?    @relation(fields: [tenantId, classId], references: [tenantId, id], onDelete: Restrict, onUpdate: Cascade)
  course       Course?   @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Restrict)
  term         AcademicTerm? @relation(fields: [tenantId, termId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, contentHash])
  @@index([tenantId, examId])
  @@index([tenantId, status, deletedAt])
  @@index([tenantId, campusId])
  @@index([tenantId, gradeLevelId])
  @@index([tenantId, classId])
  @@index([tenantId, courseId])
  @@index([tenantId, termId])
}

